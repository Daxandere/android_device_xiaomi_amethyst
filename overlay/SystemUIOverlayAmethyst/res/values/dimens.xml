<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">60.6</item>

    <!-- Upper bound for the notification shade background blur. The stock value (34dp)
         over-saturates the 1.5K panel and is the largest frame-time cost when the shade
         opens; 24dp keeps the effect visible at a lower radius. -->
    <dimen name="max_shade_window_blur_radius">24dp</dimen>
</resources>
