allow hal_power_default touchfeature_device:chr_file { open read write ioctl };
allowxperm hal_power_default touchfeature_device:chr_file ioctl { 0x5400-0x54ff };

allow hal_power_default device:dir r_dir_perms;
allow hal_power_default vendor_sysfs_touch:dir search;
allow hal_power_default vendor_sysfs_touch:file rw_file_perms;
allow hal_power_default sysfs_touch_hostprocess:file rw_file_perms;

# libperfmgr writes the nodes named in powerhint.json. The generic libperfmgr
# policy already covers /sys/devices/system/cpu and the cgroups; these are
# device specific.
allow hal_power_default vendor_sysfs_msm_perf:file rw_file_perms;
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# GPU floor: /sys/class/kgsl/kgsl-3d0/min_pwrlevel, reached through a symlink.
allow hal_power_default vendor_sysfs_kgsl:dir r_dir_perms;
allow hal_power_default vendor_sysfs_kgsl:lnk_file r_file_perms;
allow hal_power_default vendor_sysfs_kgsl:file rw_file_perms;
