# Build output
out/
*.zip
*.img
*.log

# microG prebuilts are fetched with microg/fetch-prebuilts.sh, never committed
microg/prebuilts/*.apk
microg/prebuilts/*.part

# Blob dumps
dump/
*-dump/
*.tar.md5

# Signing material — never commit
keys/
*.keystore
*.jks
*.pem
*.pk8
*.x509.pem

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
