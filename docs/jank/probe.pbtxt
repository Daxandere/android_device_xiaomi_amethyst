duration_ms: 12000

buffers { size_kb: 65536 fill_policy: RING_BUFFER }

data_sources {
  config { name: "android.surfaceflinger.frametimeline" }
}
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "dma_fence/dma_fence_wait_start"
      ftrace_events: "dma_fence/dma_fence_wait_end"
      ftrace_events: "drm/drm_vblank_event_queued"
      ftrace_events: "drm/drm_vblank_event_delivered"
      ftrace_events: "sde/sde_hw_fence_status"
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config { scan_all_processes_on_start: true }
  }
}
